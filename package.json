{
  "name": "@habix/ivana-checkout",
  "version": "0.2.0",
  "description": "Non-custodial Solana checkout on the IVANA payments engine: one buyer-signed transaction pays the merchant, VAT, the platform fee and suppliers.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Habix Group",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/checkout.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "keywords": [
    "solana",
    "checkout",
    "payments",
    "usdc",
    "non-custodial",
    "ivana"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteveTambo/ivana-checkout-sdk.git"
  },
  "homepage": "https://github.com/SteveTambo/ivana-checkout-sdk#readme",
  "bugs": {
    "url": "https://github.com/SteveTambo/ivana-checkout-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
